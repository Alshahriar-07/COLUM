# COLUM environment configuration
# Copy to .env and fill in real values. NEVER commit .env.

# --- OpenRouter (primary + fallback key) ---
OPENROUTER_API_1=
OPENROUTER_API_2=

# --- Custom OpenAI-compatible provider (optional) ---
CUSTOM_PROVIDER_NAME=
CUSTOM_PROVIDER_ENDPOINT=
CUSTOM_PROVIDER_API_KEY=
CUSTOM_PROVIDER_MODEL=

# --- Ollama (local inference, optional) ---
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# --- Backend ---
COLUM_HOST=127.0.0.1
COLUM_PORT=8765
COLUM_LOG_LEVEL=INFO

# --- Security ---
# Permission modes: confirm_risky | allow_all | strict
COLUM_PERMISSION_MODE=confirm_risky

# --- Model defaults (optional overrides; agents have built-in defaults) ---
COLUM_MODEL_INPUT_ANALYSIS=
COLUM_MODEL_PLANNER=
COLUM_MODEL_TOOL_CALL=
COLUM_MODEL_EXECUTION=
COLUM_MODEL_ERROR_HANDLER=

# --- Optional local components ---
COLUM_TESSERACT_CMD=
COLUM_WHISPER_MODEL=base.en
