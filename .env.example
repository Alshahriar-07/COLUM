# COLUM Beta 1 - Environment Configuration
# Copy this file to .env and fill in your values

# OpenRouter API Key (required for AI functionality)
# Get your key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model Configuration
# Mode: "free" (prefer free models), "paid" (prefer paid models), "specific" (use specific model)
OPENROUTER_MODE=free
# Specific model ID when mode is "specific" (e.g., "anthropic/claude-3-haiku", "meta-llama/llama-3.1-8b-instruct:free")
OPENROUTER_MODEL=
# Enable automatic fallback to alternative models on failure
OPENROUTER_FALLBACK_ENABLED=true

# Assistant Configuration
COLUM_NAME=COLUM
COLUM_WAKE_WORD=COLUM
COLUM_INACTIVITY_TIMEOUT_MINUTES=5

# Voice Configuration
# STT Provider: "whisper_local", "whisper_api", "google", "azure", "vosk"
VOICE_STT_PROVIDER=whisper_local
# TTS Provider: "edge", "google", "azure", "coqui", "piper"
VOICE_TTS_PROVIDER=edge
VOICE_PUSH_TO_TALK_ENABLED=true
VOICE_LANGUAGE=en-US

# Vision Configuration
VISION_ENABLED=true
VISION_CAPTURE_MODE=on_demand

# Security Configuration
SECURITY_CONFIRMATION_MODE=smart
SECURITY_ALLOW_FILE_DELETE=false
SECURITY_ALLOW_EXTERNAL_SEND=false
SECURITY_ALLOW_ADMIN_COMMANDS=false

# Memory Configuration
MEMORY_ENABLED=true
MEMORY_STORE_RAW_AUDIO=false
MEMORY_STORE_RAW_SCREENSHOTS=false

# Workspace Configuration
WORKSPACE_DEFAULT=Coding

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=data/logs/colum.log

# UI Configuration
UI_THEME=light
UI_ANIMATIONS_ENABLED=true

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8765
BACKEND_WS_PORT=8766